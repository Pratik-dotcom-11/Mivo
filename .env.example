# ==============================================================================
# MIVO SUPABASE CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy the Project URL and anon public key into this file
# 4. Rename this file to .env or create a new .env file in the project root
#
# SECURITY NOTICE:
# - Only the publishable/anon public key belongs here.
# - NEVER put your Supabase service_role key into this file or any frontend code!
# - NEVER put your OPENAI_API_KEY into this file! OpenAI keys belong strictly inside
#   Supabase Edge Function secrets via: `supabase secrets set OPENAI_API_KEY=your_key`
# ==============================================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Safe for browser / client-side code)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Edge Functions custom URL (defaults to ${VITE_SUPABASE_URL}/functions/v1)
VITE_SUPABASE_FUNCTIONS_URL=
